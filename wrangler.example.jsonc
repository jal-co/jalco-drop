{
  "name": "jalco-drop",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "DROPS", "bucket_name": "jalco-drop" }],
  "vars": {
    "SITE_NAME": "jalco-drop",
    "OWNER_NAME": "Your name",
    "ACCENT_COLOR": "#ff4f00",
    "CODE_THEME": "pierre-dark",
    "HOME_URL": "https://www.google.com/"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "routes": [{ "pattern": "drop.example.com", "custom_domain": true }]
}
