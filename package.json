{
  "name": "jalco-drop",
  "version": "0.1.0",
  "description": "A file, paste and screen-recording host on one Cloudflare Worker and an R2 bucket.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jal-co/jalco-drop.git"
  },
  "type": "module",
  "bin": {
    "jalco-drop": "bin/jalco-drop"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "client",
    "public/favicon.png",
    "public/fonts",
    "public/robots.txt",
    "test",
    "components.json",
    "tsconfig.json",
    "wrangler.example.jsonc",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild client/grain.js --bundle --minify --format=esm --outfile=public/grain.js && esbuild client/forms.js --minify --outfile=public/js/forms.js && esbuild client/islands.tsx --bundle --minify --format=esm --splitting --outdir=public/js --define:process.env.NODE_ENV='\"production\"' --jsx=automatic && tailwindcss -i src/styles.css -o public/style.css --minify",
    "predev": "npm run build",
    "dev": "wrangler dev --host localhost:8787",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "bash test/smoke.sh",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@paper-design/shaders": "^0.0.82",
    "@pierre/theme": "^2.0.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
