ADMIN_TOKEN=change-me
SITE_NAME=jalco-drop
OWNER_NAME=Your name
ACCENT_COLOR=#ff4f00
CODE_THEME=pierre-dark
HOME_URL=https://www.google.com/

# Storage: "disk" keeps files in /data (mount a volume). "s3" uses any S3-compatible bucket.
STORAGE=disk
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=jalco-drop
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Preview cards need Chromium (included in the image). Set to "off" to skip them.
# CARDS=off
# MAX_UPLOAD_MB=100
