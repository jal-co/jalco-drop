#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "init" ]]; then
  exec node "$(dirname "$(realpath "$0")")/../scripts/setup.mjs" "$@"
fi
if [[ "${1:-}" == "upgrade" ]]; then
  shift
  exec node "$(dirname "$(realpath "$0")")/../scripts/upgrade.mjs" "$@"
fi

usage() {
  cat <<'USAGE'
Usage: jalco-drop [options] <file | directory | ->
       jalco-drop init [directory]
       jalco-drop upgrade [version]
       jalco-drop login [url]
       jalco-drop whoami

Uploads a file, a directory (zipped), a Scrawl capture, or stdin to your drop site and prints the link.
"init" sets up a new drop site on your Cloudflare account.
A .scrawl capture uploads only its video, frames, contact sheet and transcript, and expires after 30d unless -e is set.
A Superwhisper recording folder uploads its audio and transcript, without the prompt or app context.

Options:
  -p PASSWORD   require a password to open the drop
  -s SLUG       choose the link path instead of a random one
  -e EXPIRY     expire after e.g. 12h or 7d
  -n NAME       display name (defaults to the file name)
  -j            print the upload as JSON (slug, url, password, expiry) instead of the link
  -l            list drops
  -d SLUG       delete a drop

"login" saves a site and token to ~/.config/jalco-drop/config (readable only by you).
"whoami" prints the site, the token's name and what it may do.

Environment (overrides the saved login):
  JALCO_DROP_URL    your drop site, e.g. https://drop.example.com
  JALCO_DROP_TOKEN  admin token or a named upload token
USAGE
}

config="${XDG_CONFIG_HOME:-$HOME/.config}/jalco-drop/config"
saved() { if [[ -f "$config" ]]; then sed -n "s/^$1=//p" "$config" | head -1; fi; }

if [[ "${1:-}" == "login" ]]; then
  login_url="${2:-${JALCO_DROP_URL:-}}"
  [[ -n "$login_url" ]] || { read -rp "Drop site URL: " login_url; }
  login_url="${login_url%/}"
  if [[ -t 0 ]]; then read -rsp "Token: " login_token; echo >&2; else read -r login_token; fi
  whoami="$(curl -sf -H "Authorization: Bearer $login_token" "$login_url/api/token")" || { echo "That site rejected the token." >&2; exit 1; }
  mkdir -p "$(dirname "$config")"
  (umask 077 && printf 'url=%s\ntoken=%s\n' "$login_url" "$login_token" > "$config")
  echo "Signed in to $login_url as $(jq -r '"\(.name) (\(.permissions | join(", ")))"' <<<"$whoami")"
  exit
fi

base="${JALCO_DROP_URL:-$(saved url)}"
token="${JALCO_DROP_TOKEN:-$(saved token)}"
[[ -n "$base" && -n "$token" ]] || { echo "Not signed in. Run: jalco-drop login https://drop.example.com" >&2; exit 1; }

if [[ "${1:-}" == "whoami" ]]; then
  curl -sf -H "Authorization: Bearer $token" "$base/api/token" | jq -c --arg url "$base" '{url: $url} + .' || { echo "$base rejected the token." >&2; exit 1; }
  exit
fi
password="" slug="" expires="" name="" json=""

while getopts ":p:s:e:n:jld:h" opt; do
  case "$opt" in
    p) password="$OPTARG" ;;
    s) slug="$OPTARG" ;;
    e) expires="$OPTARG" ;;
    n) name="$OPTARG" ;;
    j) json=1 ;;
    l) curl -fsS -H "Authorization: Bearer $token" "$base/api/items"; echo; exit ;;
    d) curl -fsS -X DELETE -H "Authorization: Bearer $token" "$base/api/items/$OPTARG"; echo "Deleted $OPTARG"; exit ;;
    h) usage; exit ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

target="${1:--}"
tmp=""
trap '[[ -n "$tmp" ]] && rm -rf "$tmp"' EXIT

if [[ "$target" == "-" ]]; then
  tmp="$(mktemp -d)"
  cat > "$tmp/paste.txt"
  file="$tmp/paste.txt"
  name="${name:-paste.txt}"
elif [[ -d "$target" && -f "$target/scrawl.json" ]]; then
  tmp="$(mktemp -d)"
  capture="$(basename "$(cd "$target" && pwd)" .scrawl)"
  mkdir -p "$tmp/$capture/frames"
  cp "$target/contact-sheet.png" "$tmp/$capture/"
  if [[ -f "$target/audio.wav" ]] && command -v ffmpeg >/dev/null; then
    offset="$(jq -r '(.videoOffsetMs // 0) / 1000' "$target/scrawl.json")"
    ffmpeg -loglevel error -i "$target/recording.mp4" -ss "$offset" -i "$target/audio.wav" -map 0:v -map 1:a -c:v copy -c:a aac -b:a 128k -shortest -movflags +faststart "$tmp/$capture/recording.mp4"
  else
    [[ -f "$target/audio.wav" ]] && echo "ffmpeg not found; uploading the capture without its audio" >&2
    cp "$target/recording.mp4" "$tmp/$capture/"
  fi
  cp "$target"/frames/*.png "$tmp/$capture/frames/"
  jq '{version, id, durationMs, videoOffsetMs, video, contactSheet, target: {app: .target.app, windowTitle: .target.windowTitle}, transcript: {text: .transcript.text, segments: .transcript.segments}, keyframes}' "$target/scrawl.json" > "$tmp/$capture/scrawl.json"
  (cd "$tmp" && zip -0qr "$capture.zip" "$capture")
  file="$tmp/$capture.zip"
  name="${name:-$capture.zip}"
  expires="${expires:-30d}"
elif [[ -d "$target" && -f "$target/meta.json" ]] && jq -e '.segments and .duration' "$target/meta.json" >/dev/null 2>&1; then
  tmp="$(mktemp -d)"
  note="superwhisper-$(jq -r '(.datetime // "note") | gsub("[^0-9A-Za-z]"; "")' "$target/meta.json")"
  mkdir -p "$tmp/$note"
  source_audio="$(ls "$target"/output.* 2>/dev/null | head -1)"
  [[ -n "$source_audio" ]] || { echo "No output audio in $target" >&2; exit 1; }
  audio="audio.${source_audio##*.}"
  if command -v ffmpeg >/dev/null && ffmpeg -loglevel error -i "$source_audio" -c:a aac -b:a 96k -movflags +faststart "$tmp/$note/audio.m4a"; then
    audio="audio.m4a"
  else
    cp "$source_audio" "$tmp/$note/$audio"
  fi
  jq --arg audio "$audio" '{audio: $audio, durationMs: .duration, recordedAt: .datetime, kind, text: .result, speakers: [(.speakers // [])[] | if type == "object" then (.name // .label // .id | tostring) else tostring end], segments: [.segments[] | {start, end, text, speaker}]}' "$target/meta.json" > "$tmp/$note/superwhisper.json"
  (cd "$tmp" && zip -0qr "$note.zip" "$note")
  file="$tmp/$note.zip"
  name="${name:-$note.zip}"
elif [[ -d "$target" ]]; then
  tmp="$(mktemp -d)"
  dir="$(cd "$target" && pwd)"
  (cd "$(dirname "$dir")" && zip -qr "$tmp/$(basename "$dir").zip" "$(basename "$dir")" -x '*/.DS_Store' '*/node_modules/*' '*/.git/*')
  file="$tmp/$(basename "$dir").zip"
  name="${name:-$(basename "$dir").zip}"
else
  file="$target"
  name="${name:-$(basename "$file")}"
fi

query="name=$(jq -rn --arg v "$name" '$v|@uri')"
[[ -n "$slug" ]] && query+="&slug=$(jq -rn --arg v "$slug" '$v|@uri')"
[[ -n "$expires" ]] && query+="&expires=$expires"

headers=(-H "Authorization: Bearer $token" -H "Content-Type: $(file --mime-type -b "$file")")
[[ -n "$password" ]] && headers+=(-H "X-Drop-Password: $password")

response="$(curl -sS -w '\n%{http_code}' -X POST "${headers[@]}" -T "$file" "$base/api/items?$query")"
status="${response##*$'\n'}"
body="${response%$'\n'*}"
if [[ "$status" != 201 ]]; then
  echo "Upload failed ($status): $(jq -r '.error // .' <<<"$body" 2>/dev/null || echo "$body")" >&2
  exit 1
fi
url="$(jq -r .url <<<"$body")"
if [[ -n "$json" ]]; then
  jq -c --arg name "$name" --arg expires "$expires" --arg password "$password" '{slug, url, name: $name, expires: (if $expires == "" then null else $expires end), password: (if $password == "" then null else $password end), json: "\(.url)?format=json"}' <<<"$body"
  exit
fi
echo "$url"
if [[ -t 1 ]] && command -v pbcopy >/dev/null; then
  printf '%s' "$url" | pbcopy
  echo "Copied to clipboard" >&2
fi
